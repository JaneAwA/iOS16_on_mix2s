+ # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
+diff --git a/pexpert/pexpert/arm64/POLARIS.h b/pexpert/pexpert/arm64/POLARIS.h
+new file mode 100644
+index 0000000..93eca62
+--- /dev/null
++++ b/pexpert/pexpert/arm64/POLARIS.h
+@@ -0,0 +1,48 @@
++/*
++ * Board config for the Xiaomi Mi Mix 2S ("polaris", Qualcomm SDM845 /
++ * Snapdragon 845): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no PAC.
++ *
++ * There is deliberately almost nothing here. This target is compiled with both
++ * ARM64_BOARD_CONFIG_POLARIS and ARM64_BOARD_CONFIG_SWEET (see
++ * MACHINE_FLAGS_ARM64_POLARIS in makedefs/MakeInc.def), so pexpert/arm64/SWEET.h
++ * supplies the platform description. That is correct for SDM845, not a shortcut:
++ * everything SWEET.h describes is shared Qualcomm plumbing rather than redmi-
++ * specific detail -
++ *   - generic ARM core like BCM2837: no APPLE_ARM64_ARCH_FAMILY, so none of
++ *     Apple's implementation-defined system registers are touched;
++ *   - ARMv8.2 cores without pointer authentication (Kryo 470 = A76+A55 and
++ *     Kryo 385 = A75+A55 are the same ISA level here) -> the kernel stays
++ *     plain arm64 rather than arm64e;
++ *   - GICv3 with two security states (SecurityExtn=1): TrustZone owns Group 0,
++ *     so the timer and IPIs arrive as Group 1 IRQs through sleh_irq();
++ *   - architected timer PPIs numbered 1/2/3/0, so the virtual timer used by XNU
++ *     is INTID 16 + 3 = 19;
++ *   - 16K pages, 64-byte cache lines, PSCI CPU_ON, no P/E clusters.
++ *
++ * Nothing in SWEET.h carries an SoC address - no UART, framebuffer or storage
++ * base - so what genuinely differs on this board is described in the device
++ * tree that tools/mkadt.py builds and the shim hands to the kernel:
++ *   - framebuffer  cont_splash_region 0x9d400000, size 0x2400000
++ *                  (sweet uses 0x9c000000 / 0x1700000)
++ *   - panel        1080 x 2160 S6E3HA3 AMOLED (sweet is 1080 x 2400)
++ *   - UFS          ufshc@1d84000, aperture 0x2500 (sweet uses 0x3000)
++ *   - GIC          0x17a00000 (distributor) / 0x17a60000 (redistributor)
++ * Read from the real Mix 2S DTB (dtb_36, "Polaris MP v2.1"); see
++ * ../../../../ios-port/POLARIS_HW.md for the decoded table.
++ *
++ * The MAX_* values come from the ARM64_BOARD_CONFIG_SWEET block in
++ * board_config.h and suit SDM845 unchanged for a first boot: 8 cores exposed as
++ * one homogeneous cluster (the A75s are cores 0-3, but the scheduler is not told
++ * they are faster, exactly like sweet). Adding a POLARIS block here as well
++ * would just redefine them, since both macros are set.
++ */
++
++#ifndef _PEXPERT_ARM64_POLARIS_H
++#define _PEXPERT_ARM64_POLARIS_H
++
++#include <pexpert/arm64/SWEET.h>
++
++#define POLARIS                        1
++#define SDM845                         1
++
++#endif /* ! _PEXPERT_ARM64_POLARIS_H */
